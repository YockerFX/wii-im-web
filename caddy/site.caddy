# Gemeinsamer Site-Block für Prod (Caddyfile) und Dev (Caddyfile.dev).
# Kein `encode`: Unity-Dateien sind vorkomprimiert (.br) und würden sonst doppelt komprimiert.

header {
	Strict-Transport-Security "max-age=63072000; includeSubDomains"
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
	Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline' blob:; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	-Server
}

# Signaling-WebSocket und Health → Node-Container (Upgrade + X-Forwarded-For setzt Caddy selbst)
handle /ws {
	reverse_proxy signaling:8080
}
handle /healthz {
	reverse_proxy signaling:8080
}

# Statische Dateien: Next.js-Export + Unity-Build aus dem Release-Symlink (06)
handle {
	root * /srv/current

	# Der Unity-Loader fordert *.br direkt an → Encoding und MIME selbst setzen
	@br path *.br
	header @br Content-Encoding br
	@wasmbr path *.wasm.br
	header @wasmbr Content-Type application/wasm
	@jsbr path *.js.br
	header @jsbr Content-Type application/javascript
	@databr path *.data.br
	header @databr Content-Type application/octet-stream

	# gehashte Dateien ein Jahr cachen, alles andere (HTML, Manifest) nie
	@immutable path /Build/* /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /Build/* /_next/static/*
	header @mutable Cache-Control no-cache

	# Next.js static export: /controller → controller.html
	try_files {path} {path}.html {path}/
	file_server
}
